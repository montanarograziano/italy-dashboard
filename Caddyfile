# Single-port entry point for Render's free tier (one exposed port, TLS
# terminated by Render itself). Caddy serves the exported static frontend and
# reverse-proxies the handful of routes Reflex's backend actually owns.
#
# Route list verified against the installed reflex==0.9.8 backend
# (reflex_base/constants/event.py `Endpoint`, reflex/app.py `_add_default_endpoints`
# / `_add_optional_endpoints`):
#   /_event/*  - the Socket.IO/websocket endpoint (state sync, mounted with a
#                catch-all path, so it must be proxied as a prefix)
#   /ping      - trivial liveness probe, also used as the Render health check
#   /_upload   - file upload endpoint (registered only if rx.upload() is used;
#                this app doesn't use it today, but proxying it is harmless
#                and keeps the Caddyfile correct if that changes)
# Everything else is served from the pre-exported static frontend bundle.
{
	auto_https off
}

:{$PORT} {
	@backend path /_event/* /ping /_upload

	handle @backend {
		reverse_proxy localhost:8000
	}

	handle {
		root * /srv/frontend
		# `{path}` alone only matches a file whose name is the literal request
		# path -- Reflex's static export writes each route as BOTH `<route>.html`
		# and `<route>/index.html` (see `.web/build/client/`), never a bare
		# extension-less file, so `try_files {path} /index.html` (the previous
		# rule) never matched a route file directly and fell straight to the
		# LAST resort every time: every direct/full-page load of any route other
		# than `/` silently served home's prerendered HTML with a 200, while the
		# URL bar still showed the real route. React Router then hydrated
		# against that real URL, rendered that route's actual page client-side,
		# and it could not match the home markup the server had actually sent --
		# a guaranteed React error #418 (hydration mismatch) on every route load,
		# reproduced locally by serving this exact exported build through this
		# exact directive (see docs/12-deployment.md's "Routing" section).
		# `{path}.html` and `{path}/` try the route's OWN prerendered file
		# first, so the served markup actually matches the requested route and
		# hydration has nothing to reconcile. `/404.html` (not `/index.html`) is
		# the final fallback for a genuinely unmatched path: it is Reflex's own
		# generic pre-hydration shell (react-router's `HydrateFallback`, not a
		# specific page's prerendered markup), so a truly unknown URL does not
		# repeat the same mismatch one level up by claiming to be home.
		try_files {path} {path}.html {path}/ /404.html
		file_server
	}

	encode gzip
}
