*.db
.states
.web
*.py[cod]
# Data snapshots (regenerate with: python -m ingestion.fetch refresh)
# Snapshots are normally regenerable and stay out of git. The exception below
# exists because the deployment builds from a clean clone (Render), and the
# weather half of the data now takes days of rate-limited fetching to rebuild,
# so "just re-run the pipeline" is no longer a cheap recovery. See
# docs/02-architecture.md.
data/*
!data/.gitkeep

# Reflex
.web/
.states/
assets/external/

# Static (TypeScript) frontend
web/node_modules/
web/dist/
web/dist-pages-subpath/
# Vite publicDir target, regenerated by scripts/stage_web_data.py (predev/
# prebuild hooks in web/package.json). Never a source of truth.
web/public-data/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.pyrefly_cache/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
logs/

# zensical docs build
site/
.zensical/

# bridge transfer leftovers
_to_delete/

# Agent scratch: plans, ledgers and task reports. Never shipped code.
.superpowers/

# Tracked exception: exactly the parquet the running app queries, nothing else.
# Release normalized snapshots are checked in so manifest hashes can be
# verified from a clean clone; raw inputs and caches remain ignored.
!data/.gitkeep
!data/*.parquet
# dbt input only (17 MB); the tracked climate marts are its verified product.
data/weather_daily.parquet
!data/marts/
data/marts/*
!data/marts/*.parquet
# Release evidence is checked in; raw/source caches remain ignored.
!data/release-manifest.json
!data/source-receipts.json

# Copernicus CDS API credentials (never commit)
.cdsapirc
