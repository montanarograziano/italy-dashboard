*.db
.states
.web
*.py[cod]
# Data snapshots (regenerate with: python -m ingestion.fetch refresh)
# Snapshots are normally regenerable and stay out of git. The exception below
# exists because the deployment builds from a clean clone (Render), and the
# weather half of the data now takes days of rate-limited fetching to rebuild,
# so "just re-run the pipeline" is no longer a cheap recovery. See
# docs/02-architecture.md.
data/*
!data/.gitkeep

# Reflex
.web/
.states/
assets/external/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.pyrefly_cache/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
logs/

# zensical docs build
site/
.zensical/

# bridge transfer leftovers
_to_delete/

# Agent scratch: plans, ledgers and task reports. Never shipped code.
.superpowers/

# Tracked exception: exactly the parquet the running app queries, nothing else.
# dbt inputs (weather_daily, the raw normalized ISTAT snapshots) stay ignored:
# the container never runs dbt, it reads pre-built marts.
!data/.gitkeep
!data/population_resident.parquet
!data/population_foreign.parquet
!data/labor_unemployment.parquet
!data/economy_inflation.parquet
!data/marts/
data/marts/*
!data/marts/*.parquet
